{
  "name": "@hyperstructure/design",
  "version": "0.4.0",
  "description": "hyperstructure's design system: brand tokens, fonts, the WebGL scenes, hyperstructure's symbol and fctl's mark and app icons",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperstructure/design.git"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./brand": "./src/brand.ts",
    "./gl/core": "./src/gl/core.ts",
    "./gl/foundry": "./src/gl/foundry.ts",
    "./gl/orb": "./src/gl/orb.ts",
    "./assets/mark.svg": "./assets/mark.svg",
    "./assets/favicon.svg": "./assets/favicon.svg",
    "./assets/icons/*": "./assets/icons/*",
    "./package.json": "./package.json",
    "./assets/hyperstructure/*": "./assets/hyperstructure/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "icons": "node scripts/icons.mjs",
    "check": "biome check . && tsc --noEmit",
    "fix": "biome check --write .",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
